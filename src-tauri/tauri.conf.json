{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nertz",
  "version": "0.1.0",
  "identifier": "com.nertz.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Nertz", "width": 1280, "height": 720, "minWidth": 640, "minHeight": 480, "fullscreen": true, "backgroundColor": "#000000" }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "both" } }
  }
}
